@page "/"
@using Services.Interfaces
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using App_UI.Components.Layout
@inject ISesionService SesionService
@inject ProtectedSessionStorage SesionStorage
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="container mt-5">
    <div class="card mx-auto shadow" style="max-width: 400px;">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">Mundial 2026 - Login</h4>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label>Email</label>
                <input @bind="email" class="form-control" placeholder="nombre@email.com" />
            </div>
            <div class="mb-3">
                <label>Password</label>
                <input @bind="pass" type="password" class="form-control" />
            </div>
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger p-2 small">@error</div>
            }
            <button class="btn btn-primary w-100" @onclick="ManejarLogin">Entrar</button>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string pass = "";
    private string error = "";

    private async Task ManejarLogin()
    {
        try {
            error = "";
            SesionService.Login(email, pass);
            // Persiste el correo para restaurar la sesión tras un refresh.
            await SesionStorage.SetAsync(MainLayout.ClaveCorreoSesion, email);
            Nav.NavigateTo("/home");
        } catch (Exception ex) {
            error = ex.Message;
        }
    }
    
    
}

